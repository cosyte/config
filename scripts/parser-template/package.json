{
  "name": "{{PKG}}",
  "version": "0.0.0",
  "description": "{{TITLE}} parser, serializer, and builder for Node.js and TypeScript: lenient on parse, spec-clean on emit.",
  "keywords": [
    "{{NAME}}",
    "parser",
    "healthcare",
    "interoperability",
    "typescript",
    "serializer"
  ],
  "homepage": "https://github.com/cosyte/{{NAME}}#readme",
  "bugs": {
    "url": "https://github.com/cosyte/{{NAME}}/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/{{NAME}}.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "check:process": "cosyte-process check",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "clean": "rm -rf dist coverage",
    "pack:docs": "bash scripts/build-docs-artifacts.sh",
    "attw": "node scripts/attw.mjs",
    "check:no-emdash": "bash node_modules/@cosyte/script-utils/check-no-emdash.sh",
    "release": "changeset publish",
    "version": "changeset version && cosyte-process sync-version && cosyte-docs-reference && cosyte-process format",
    "check:release-pr": "cosyte-release-pr",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.8",
    "@cosyte/script-utils": "^0.1.13",
    "@cosyte/test-utils": "^0.1.3",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.3",
    "@types/node": "^22.0.0",
    "fast-check": "3.23.2",
    "simple-git-hooks": "2.13.0",
    "tsx": "4.21.0",
    "vitest": "5.1.0"
  },
  "dependencies": {},
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2"
    }
  }
}
