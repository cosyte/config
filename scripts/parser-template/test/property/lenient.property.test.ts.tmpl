describe("lenient never throws", () => {
  it("throws only a fatal code on hostile input, and every warning has a registered code", () => {
    lenientNeverThrowsProperty({
      arbitrary: hostile{{Pascal}}Text(),
      parse: (raw) => parse{{Pascal}}(raw),
      isFatal: (error) => error instanceof {{Pascal}}ParseError && fatalCodes.has(error.code),
      getWarnings: (parsed) => (parsed as {{Pascal}}Document).warnings,
      isKnownCode: (code) => warningCodes.has(code),
      hasPositionalContext: (warning) =>
        typeof (warning.position as { segmentIndex?: unknown } | undefined)?.segmentIndex ===
        "number",
    });
  });
});
