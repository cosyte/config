{
  "name": "@cosyte/script-utils",
  "version": "0.0.1",
  "description": "Zero-dependency helpers for the repo-local gate scripts in @cosyte/* repos.",
  "keywords": [
    "cli",
    "entrypoint",
    "import-meta",
    "phi",
    "scripts",
    "cosyte"
  ],
  "homepage": "https://github.com/cosyte/config/tree/main/packages/script-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/config.git",
    "directory": "packages/script-utils"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./phi-scan": {
      "types": "./phi-scan.d.ts",
      "default": "./phi-scan.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "phi-scan.js",
    "phi-scan.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
