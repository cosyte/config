{
  "name": "@cosyte/script-utils",
  "version": "0.1.9",
  "description": "Zero-dependency helpers for the repo-local gate scripts in @cosyte/* repos.",
  "keywords": [
    "cli",
    "bin",
    "entrypoint",
    "import-meta",
    "phi",
    "readme",
    "scripts",
    "cosyte",
    "coverage",
    "mutation-testing"
  ],
  "homepage": "https://github.com/cosyte/config/tree/main/packages/script-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/config.git",
    "directory": "packages/script-utils"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "main": "index.js",
  "bin": {
    "script-utils": "bin/script-utils.js",
    "cosyte-no-emdash": "bin/cosyte-no-emdash.js",
    "cosyte-attw": "bin/cosyte-attw.js",
    "cosyte-phi-scan": "bin/cosyte-phi-scan.js",
    "cosyte-internal-refs": "bin/cosyte-internal-refs.js",
    "cosyte-readme": "bin/cosyte-readme.js",
    "cosyte-claude-card": "bin/cosyte-claude-card.js",
    "cosyte-agent-notes": "bin/cosyte-agent-notes.js",
    "cosyte-catalog": "bin/cosyte-catalog.js",
    "cosyte-ratchet": "bin/cosyte-ratchet.js",
    "cosyte-docs-content": "bin/cosyte-docs-content.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./phi-scan": {
      "types": "./phi-scan.d.ts",
      "default": "./phi-scan.js"
    },
    "./internal-refs": {
      "types": "./internal-refs.d.ts",
      "default": "./internal-refs.js"
    },
    "./attw": {
      "types": "./attw.d.ts",
      "default": "./attw.js"
    },
    "./readme": {
      "types": "./readme.d.ts",
      "default": "./readme.js"
    },
    "./claude-card": {
      "types": "./claude-card.d.ts",
      "default": "./claude-card.js"
    },
    "./catalog": {
      "types": "./catalog.d.ts",
      "default": "./catalog.js"
    },
    "./agent-notes": {
      "types": "./agent-notes.d.ts",
      "default": "./agent-notes.js"
    },
    "./ratchet": {
      "types": "./ratchet.d.ts",
      "default": "./ratchet.js"
    },
    "./changes": {
      "types": "./changes.d.ts",
      "default": "./changes.js"
    },
    "./docs-content": {
      "types": "./docs-content.d.ts",
      "default": "./docs-content.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "phi-scan.js",
    "phi-scan.d.ts",
    "internal-refs.js",
    "internal-refs.d.ts",
    "attw.js",
    "attw.d.ts",
    "readme.js",
    "readme.d.ts",
    "claude-card.js",
    "claude-card.d.ts",
    "catalog.js",
    "catalog.d.ts",
    "catalog.json",
    "agent-notes.js",
    "agent-notes.d.ts",
    "ratchet.js",
    "ratchet.d.ts",
    "changes.js",
    "changes.d.ts",
    "docs-content.js",
    "docs-content.d.ts",
    "check-no-emdash.sh",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/pack-emdash-gate.mjs",
    "prepack": "node ../../scripts/pack-emdash-gate.mjs",
    "prepublishOnly": "node ../../scripts/pack-emdash-gate.mjs",
    "test": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "5.1.0",
    "@vitest/coverage-v8": "5.1.0"
  }
}
