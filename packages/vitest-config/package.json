{
  "name": "@cosyte/vitest-config",
  "version": "0.1.3",
  "description": "Shared Vitest config (v8 coverage, per-directory >=90 gates) and StrykerJS mutation testing config for @cosyte/* packages.",
  "keywords": [
    "vitest",
    "coverage",
    "test",
    "doctest",
    "documentation",
    "cosyte",
    "stryker",
    "mutation-testing"
  ],
  "homepage": "https://github.com/cosyte/config/tree/main/packages/vitest-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/config.git",
    "directory": "packages/vitest-config"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "cosyte-mutate": "bin/cosyte-mutate.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./snippets": {
      "types": "./snippets.d.ts",
      "default": "./snippets.js"
    },
    "./stryker": {
      "types": "./stryker.d.ts",
      "default": "./stryker.js"
    },
    "./mutate": {
      "types": "./mutate.d.ts",
      "default": "./mutate.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "snippets.js",
    "snippets.d.ts",
    "stryker.js",
    "stryker.d.ts",
    "mutate.js",
    "mutate.d.ts",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "@cosyte/script-utils": "workspace:^",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.0 || ^5.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vitest": "^4.0.0 || ^5.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@cosyte/script-utils": {
      "optional": true
    },
    "@stryker-mutator/core": {
      "optional": true
    },
    "@stryker-mutator/vitest-runner": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cosyte/script-utils": "workspace:^",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "typescript": "5.9.3"
  }
}
